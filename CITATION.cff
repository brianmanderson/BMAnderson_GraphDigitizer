    affiliation: "University of California San Diego"
version: 1.0.0
date-released: 2026-11-07
license: MIT
repository-code: "https://github.com/brianmanderson/UCSD_GraphEvaluator"
url: "https://brianmanderson.github.io/UCSD_GraphEvaluator/"
